  "components": {
    "schemas": {
      "Challenge": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id"
        ],
        "title": "Challenge"
      },
      "Email": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Email"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email"
        ],
        "title": "Email"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginInput": {
        "properties": {
          "login": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Login"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          },
          "device_proof": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 32,
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Proof"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "title": "LoginInput"
      },
      "NoteChange": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 4000,
            "title": "Body"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "body"
        ],
        "title": "NoteChange"
      },
      "Otp": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "code": {
            "type": "string",
            "maxLength": 8,
            "minLength": 8,
            "format": "password",
            "title": "Code",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "code"
        ],
        "title": "Otp"
      },
      "Password": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "password"
        ],
        "title": "Password"
      },
      "Recover": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "code": {
            "type": "string",
            "maxLength": 8,
            "minLength": 8,
            "format": "password",
            "title": "Code",
            "writeOnly": true
          },
          "recovery_code": {
            "type": "string",
            "maxLength": 128,
            "minLength": 32,
            "format": "password",
            "title": "Recovery Code",
            "writeOnly": true
          },
          "new_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "format": "password",
            "title": "New Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "code",
          "recovery_code",
          "new_password"
        ],
        "title": "Recover"
      },
      "Registration": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 12,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Registration"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
